{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminar.local/schemas/public-apify-examples-catalog.schema.json",
  "title": "Luminar public Apify examples catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "repository", "actorCount", "actors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "remoteUrl", "commitSha", "approvalGranted", "publicReadback"],
      "properties": {
        "name": { "const": "luminar-apify-examples" },
        "status": { "const": "LOCAL_HASH_LOCKED_STAGING" },
        "remoteUrl": { "type": "null" },
        "commitSha": { "type": "null" },
        "approvalGranted": { "const": false },
        "publicReadback": { "const": "NOT_RUN" }
      }
    },
    "actorCount": { "type": "integer", "minimum": 1 },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actorKey", "actorRef", "title", "storeUrl", "sourceLockSha256", "manifestPath"],
        "properties": {
          "actorKey": { "type": "string", "minLength": 1 },
          "actorRef": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "storeUrl": { "type": "string", "pattern": "^https://apify\\.com/" },
          "sourceLockSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "manifestPath": { "type": "string", "pattern": "^actors/.+/manifest\\.json$" }
        }
      }
    }
  }
}

